{
  "name": "@yasirdora/focus-trace",
  "version": "0.1.0",
  "private": true,
  "description": "Focus timelines for Playwright test failures.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit && npm run test:browser",
    "prepack": "npm run build",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:browser": "playwright test",
    "test:failure": "node scripts/verify-failure.mjs",
    "verify": "node scripts/verify-package.mjs",
    "typecheck:tests": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext playwright.config.ts test/*.spec.ts test/fixture-cases/*.ts examples/*.ts"
  },
  "peerDependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
